MONGODB_URI=mongodb://127.0.0.1:27017/ghostnote
MONGODB_DB=ghostnote

# Optional. When set, checkout redirects to Stripe instead of the local MongoDB path.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Live GitHub issues, stars, and contributors. Use owner/repo.
NEXT_PUBLIC_GITHUB_REPO=v0nser/ghostnote
GITHUB_REPO=v0nser/ghostnote
# Optional. Raises the GitHub API rate limit for live polling.
GITHUB_TOKEN=
