# --- Database (MongoDB Atlas, free M0 cluster) ---
# Atlas → Connect → Drivers → copy the URI, replace <password>
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ghostnote?retryWrites=true&w=majority
MONGODB_DB=ghostnote

# --- Payments (Polar — easiest global cards, payouts to your bank) ---
# https://polar.sh → create org → Products → copy product IDs
# Settings → Developers → Organization Access Token (checkouts:write, products:read)
# Settings → Webhooks → https://YOUR_DOMAIN/api/webhooks/polar
#   events: checkout.updated, order.paid, subscription.active
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID_PRO=
POLAR_PRODUCT_ID_TEAM=
POLAR_WEBHOOK_SECRET=
# Use sandbox while testing: POLAR_SERVER=sandbox
POLAR_SERVER=production

# Optional fallback if you already have Stripe (slower approvals, not needed if Polar is set).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Live GitHub issues, stars, and contributors.
NEXT_PUBLIC_GITHUB_REPO=v0nser/ghostnote
GITHUB_REPO=v0nser/ghostnote
# Optional. Raises the GitHub API rate limit for live polling.
GITHUB_TOKEN=
