---
import { site } from "../content/site";
---

<section id="principles" class="mx-auto max-w-7xl px-4 py-24 md:px-8 md:py-36">
  <p class="eyebrow">{site.principles.eyebrow}</p>
  <ol class="mt-12 space-y-16 md:space-y-28">
    {
      site.principles.items.map((item, i) => (
        <li class="reveal grid gap-4 border-t border-ink/10 pt-6 md:grid-cols-[100px_1fr_320px] md:items-end md:gap-8">
          <span class="font-mono text-xs text-ink-3">{String(i + 1).padStart(2, "0")}</span>
          <p class="font-display text-[clamp(2.8rem,8vw,7.2rem)] leading-[0.88] tracking-[-0.04em]">{item.big}</p>
          <p class="text-ink-2 md:pb-4">{item.small}</p>
        </li>
      ))
    }
  </ol>
</section>
