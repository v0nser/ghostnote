---
import { site } from "../content/site";
---

<section id="limits" class="bg-paper-2/60">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-24 md:grid-cols-[1fr_1.6fr] md:px-8 md:py-32">
    <div>
      <p class="eyebrow">{site.honest.eyebrow}</p>
      <h2 class="mt-4 font-display text-[clamp(2.6rem,6vw,5rem)] leading-[0.9] tracking-[-0.04em]">{site.honest.title}</h2>
    </div>
    <ol class="grid gap-px overflow-hidden rounded-[24px] border border-ink/10 bg-ink/10 sm:grid-cols-2">
      {
        site.honest.items.map((item, i) => (
          <li class="reveal bg-paper p-6">
            <span class="font-mono text-[11px] text-ink-3">{String(i + 1).padStart(2, "0")}</span>
            <p class="mt-3 leading-relaxed">{item}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
